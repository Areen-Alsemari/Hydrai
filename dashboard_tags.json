    {"tag": "LH2-TT-101", "channel": "liquid_temp_inner", "unit": "K", "accuracy": "+-0.5 C", "sample_period_s": 1, "source": "SPEC"},
    {"tag": "LH2-TT-102", "channel": "outer_wall_temp", "unit": "K", "accuracy": "+-0.5 C", "sample_period_s": 5, "source": "SPEC"},
    {"tag": "LH2-AT-101", "channel": "h2_ambient_detector", "unit": "%LFL", "range": [0, 100], "sample_period_s": 0.2, "response_s": [10, 15],
