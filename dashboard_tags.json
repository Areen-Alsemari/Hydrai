    {"tag": "LH2-LT-101", "channel": "level", "unit": "%", "range": [0, 100], "sample_period_s": 1, "accuracy": "0.5% FS", "technique": "DP gauge", "source": "SPEC"},
    {"tag": "LH2-FT-101", "channel": "fill_flow", "unit": "kg/s", "sample_period_s": 0.1, "accuracy": "1% FS", "source": "SPEC"},
    {"tag": "LH2-FT-102", "channel": "discharge_flow", "unit": "kg/s", "sample_period_s": 0.1, "accuracy": "1% FS", "source": "SPEC"},
    {"tag": "LH2-SE-101", "channel": "strain", "unit": "microstrain", "sample_period_s": 0.1, "accuracy": "1% FS", "source": "SPEC"},
